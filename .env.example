# Base URL used for canonical URLs, sitemap and schema output
NEXT_PUBLIC_SITE_URL=https://ops.withtatva.ai
# SQLite file (created automatically)
BLOG_DB_PATH=./data/blog.db
# Where uploaded and generated images are written (served via /uploads/<file>)
BLOG_UPLOAD_DIR=./data/uploads
# Anthropic API key powering the editor's AI tools
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: Google Search Console Indexing API service account (JSON string)
GSC_INDEXING_SERVICE_ACCOUNT=
# Secret required by /api/cron/publish-scheduled
CRON_SECRET=
