# Base URL used for canonical URLs, sitemap and schema output
NEXT_PUBLIC_SITE_URL=https://ops.withtatva.ai

# --- Storage -----------------------------------------------------------------
# REQUIRED on serverless hosts (Vercel, Lambda): every instance has its own
# filesystem, so a local file is not shared between two requests. Any hosted
# libSQL database works — Turso has a free tier.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local/self-hosted only: path to the SQLite file when no hosted database is set
BLOG_DB_PATH=./data/blog.db

# --- AI tools ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional ----------------------------------------------------------------
# Google Search Console Indexing API service account (JSON string)
GSC_INDEXING_SERVICE_ACCOUNT=
# Secret required by /api/cron/publish-scheduled
CRON_SECRET=
